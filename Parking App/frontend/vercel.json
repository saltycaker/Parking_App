{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "site"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/site/$1"
    }
  ],
  "env": {
    "API_BASE_URL": "https://parking-api.onrender.com",
    "LEPTOS_SITE_ADDR": "127.0.0.1:3000",
    "LEPTOS_SITE_ROOT": "site"
  }
}
